{
  "name": "lostless",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Personal navigation / map app. 100% free: MapLibre + OpenFreeMap tiles, Nominatim search, public Valhalla/OSRM routing.",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "tsc -b && vite build",
    "prepreview": "node scripts/copy-maplibre-worker.mjs",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/space-grotesk": "^5.2.5",
    "maplibre-gl": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.3",
    "leaflet": "^1.9.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
